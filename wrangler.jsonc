{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plobi-kit",
  "compatibility_date": "2026-06-08",
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*", "/deals", "/deals/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plobikit",
      "database_id": "92172fd8-5598-4035-a5b3-211b35bc7332"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "compatibility_flags": ["nodejs_compat"]
}
